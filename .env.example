# ========================================================================================
# Offline-College-Bot Configuration Template
# Copy this to .env and fill in your actual values
# ========================================================================================

# ── Application Settings ─────────────────────────────────────────────────────────────────
APP_NAME=Academic AI System
VERSION=1.0.0
DEBUG=False
HOST=127.0.0.1
PORT=8000

# ── Security Settings ────────────────────────────────────────────────────────────────────
SECRET_KEY=academic-ai-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================================================================
# AI PROVIDER CONFIGURATION - CHOOSE ONE
# ========================================================================================

# Option 1: Use Grok API (Primary - Recommended for production)
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=grok
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini

# Option 2: Use Ollama (Local - Recommended for offline/low-cost)
# ────────────────────────────────────────────────────────────────
# AI_PROVIDER=ollama

# Request Timeout (seconds) - Used for all API requests
REQUEST_TIMEOUT=30

# ========================================================================================
# OLLAMA CONFIGURATION - Used when AI_PROVIDER=ollama or as fallback
# ========================================================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAIN_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_FAST_MODEL=phi3
OLLAMA_CODE_MODEL=deepseek-coder

# ========================================================================================
# VECTOR STORE & RAG CONFIGURATION
# ========================================================================================

CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=academic_documents

# RAG Parameters
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ========================================================================================
# FILE & DIRECTORY PATHS
# ========================================================================================

UPLOAD_DIR=./documents
AUDIO_DIR=./audio
CACHE_DIR=./cache
LOGS_DIR=./logs

# Database
DATABASE_URL=sqlite+aiosqlite:///./academic_ai.db

# File Upload Settings
MAX_FILE_SIZE_MB=50

# ========================================================================================
# SPEECH & AUDIO SETTINGS
# ========================================================================================

# Speech-to-Text (Whisper)
WHISPER_MODEL=base

# Text-to-Speech (Piper)
PIPER_MODEL_DIR=./models/piper

# ========================================================================================
# LANGUAGE & TRANSLATION SETTINGS
# ========================================================================================

SUPPORTED_LANGUAGES=en,hi,kn
DEFAULT_LANGUAGE=en

# ========================================================================================
# CORS CONFIGURATION
# ========================================================================================

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
