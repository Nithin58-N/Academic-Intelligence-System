# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Academic AI System"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production

# ── AI Provider ───────────────────────────────────────────────────────────────
# "groq" = Groq cloud API (fast, recommended)
# "ollama" = local Ollama (fully offline)
AI_PROVIDER=groq

# ── Groq Configuration ────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Available models: llama-3.1-8b-instant | llama3-70b-8192 | gemma2-9b-it | mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (embeddings + optional offline fallback) ───────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAIN_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_FAST_MODEL=phi3

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_DIR=./chroma_db

# ── Directories ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./documents
AUDIO_DIR=./audio
CACHE_DIR=./cache
LOGS_DIR=./logs

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./academic_ai.db

# ── PDF Processing ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Speech ────────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
PIPER_MODEL_DIR=./models/piper

# ── RAG ───────────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
