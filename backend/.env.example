# Application
APP_NAME="Academic AI System"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-this-in-production

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
MAIN_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text
FAST_MODEL=phi3

# ChromaDB
CHROMA_DIR=./chroma_db

# Directories
UPLOAD_DIR=./documents
AUDIO_DIR=./audio
CACHE_DIR=./cache
LOGS_DIR=./logs

# Database
DATABASE_URL=sqlite+aiosqlite:///./academic_ai.db

# PDF Processing
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Speech
WHISPER_MODEL=base
PIPER_MODEL_DIR=./models/piper

# RAG
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
