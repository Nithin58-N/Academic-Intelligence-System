# ── Frontend Environment Variables ───────────────────────────────────────────
#
# Copy this file to .env.local for local development.
# On Vercel, add these as Environment Variables in the project settings.
#
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are embedded at build time
# and are visible in the browser bundle. Never put secrets here.

# URL of the deployed backend (Render).
# • Production: https://academic-intelligence-system.onrender.com
# • Local dev:  leave empty — next.config.mjs falls back to http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=https://academic-intelligence-system.onrender.com
